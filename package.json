{
  "name": "futbolquiz-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config configuracionVite.js",
    "build": "vite build --config configuracionVite.js",
    "preview": "vite preview --config configuracionVite.js",
    "test": "node scripts/limpiarCobertura.js && playwright test --config configuracionNavegador.js && nyc report --reporter=lcov --reporter=text-summary"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.0.2",
    "nyc": "^18.0.0",
    "vite": "^8.0.14",
    "vite-plugin-istanbul": "^9.0.1"
  },
  "nyc": {
    "all": true,
    "extension": [
      ".js",
      ".jsx"
    ],
    "include": [
      "src/**/*.js",
      "src/**/*.jsx"
    ],
    "exclude": [
      "src/**/*.spec.js",
      "src/**/*.test.js",
      "src/**/*.spec.jsx",
      "src/**/*.test.jsx"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ],
    "report-dir": "coverage",
    "temp-dir": ".nyc_output"
  }
}
